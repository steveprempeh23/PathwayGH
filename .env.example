# Ollama connection
OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Storage
SQLITE_PATH=./data/app_state.db
CHROMA_PERSIST_DIR=./data/chroma

# App
APP_ENV=development
LOG_LEVEL=INFO

# No API keys are required for this deployment: all model inference happens
# locally via Ollama. If a hosted LLM provider is swapped in later, its key
# goes here and must never be committed - copy this file to .env and fill
# in real values there (.env is gitignored).
